# App
# production | development | empty = auto (https → production)
APP_ENV=production
# Comma-separated emails that become admin on login
ADMIN_EMAILS=bruno.magalhaess@gmail.com
PUBLIC_APP_URL=https://seu-dominio.com
CORS_ORIGINS=https://seu-dominio.com
JWT_SECRET=troque-por-segredo-longo-aleatorio
JWT_EXPIRE_MINUTES=10080

# Leave empty in production so the browser calls same-origin /api (Next proxies to backend).
NEXT_PUBLIC_API_URL=

# Database
DATABASE_URL=postgresql+psycopg://mycartao:SENHA_FORTE@db:5432/mycartao
POSTGRES_USER=mycartao
POSTGRES_PASSWORD=SENHA_FORTE
POSTGRES_DB=mycartao

# Brevo (obrigatório em produção)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@seu-dominio.com
BREVO_SENDER_NAME=MyCartao

# Stripe LIVE (não use sk_test_ em produção)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...

# MinIO (internal only — browsers never talk to MinIO directly)
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=troque-minio-user
MINIO_SECRET_KEY=troque-minio-senha-forte
MINIO_BUCKET=mycartao
MINIO_USE_SSL=false
